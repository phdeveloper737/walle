APP_NAME=walle
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco do walle (contêiner walle-mysql). No Windows: localhost:WALLE_PORTA_MYSQL
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=walle
DB_USERNAME=walle
DB_PASSWORD=
DB_COLLATION=utf8mb4_general_ci
WALLE_MYSQL_ROOT_SENHA=

# Sessão, cache e filas no Valkey (contêiner walle-valkey)
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=walle

REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="walle@localhost"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Portas no Windows (docker-compose)
WALLE_PORTA=8080
WALLE_PORTA_MYSQL=3309

# Help Desk (192.168.10.254): login e base de consulta, SOMENTE LEITURA.
# A senha do banco vem da API (.251), como no sistema antigo; a reserva é usada se a API falhar.
HELP_DB_HOST=192.168.10.254
HELP_DB_PORT=3306
HELP_DB_DATABASE=suporte
HELP_DB_USERNAME=root
HELP_DB_SENHA_RESERVA=
HELP_API_URL=http://192.168.10.251/api
HELP_API_TOKEN=

# Banco "suporte" do sistema antigo: origem do importador (walle:importar-suporte). Em dev: MySQL do testes220
SUPORTE_DB_HOST=host.docker.internal
SUPORTE_DB_PORT=3307
SUPORTE_DB_DATABASE=suporte
SUPORTE_DB_USERNAME=root
SUPORTE_DB_SENHA=

# Servidores dos clientes (contingências do Sactus/PDV Linux), SOMENTE LEITURA.
# Senha do root do MySQL no Docker da JM (192.168.10.244 e .235); os demais servidores usam a senha do cadastro no Help Desk.
CLIENTES_DOCKER_SENHA_ROOT=

# Sefaz GO (consulta de NF-e/NFC-e): certificado A1 fica em storage/app/private/certificados (fora do site)
SEFAZ_CERTIFICADO_SENHA=
SEFAZ_AMBIENTE=1
# Robô das autorizadas (liga/desliga)
WALLE_AUTORIZADAS_ATIVO=false

# Admins do walle: ids do a_user (Help Desk) separados por vírgula. Fazem as ações que mexem fora do walle e veem segredos.
WALLE_ADMINS=

# Robô do Sactus (SSH nos servidores dos clientes): liga só na virada, junto com o desligamento do sactus.php no 220
WALLE_SACTUS_ATIVO=false
# Atualização do ERP (rsync a partir do 220): senha do root da origem
SACTUS_ERP_SENHA=
SACTUS_ERP_ORIGEM=root@192.168.10.220:/var/sistema/*
SACTUS_ERP_PORTA=22
