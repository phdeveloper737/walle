APP_NAME=walle
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco do walle (contêiner walle-mysql). No Windows: localhost:WALLE_PORTA_MYSQL
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=walle
DB_USERNAME=walle
DB_PASSWORD=
DB_COLLATION=utf8mb4_general_ci
WALLE_MYSQL_ROOT_SENHA=

# Sessão, cache e filas no Valkey (contêiner walle-valkey)
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=walle

REDIS_CLIENT=phpredis
REDIS_HOST=valkey
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="walle@localhost"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Portas no Windows (docker-compose)
WALLE_PORTA=8080
WALLE_PORTA_MYSQL=3309

# Help Desk (192.168.10.254): login e base de consulta, SOMENTE LEITURA.
# A senha do banco vem da API (.251), como no sistema antigo; a reserva é usada se a API falhar.
HELP_DB_HOST=192.168.10.254
HELP_DB_PORT=3306
HELP_DB_DATABASE=suporte
HELP_DB_USERNAME=root
HELP_DB_SENHA_RESERVA=
HELP_API_URL=http://192.168.10.251/api
HELP_API_TOKEN=
