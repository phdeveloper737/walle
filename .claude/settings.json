{
    "permissions": {
        "additionalDirectories": [
            "C:/docker/testes220/newsuporte"
        ],
        "deny": [
            "Read(./.env)",
            "Read(./.env.backup)",
            "Read(./.env.production)",
            "Read(./.env.local)",
            "Read(./.env.*.local)",
            "Read(./**/.env)",
            "Read(./auth.json)",
            "Read(./storage/*.key)",
            "Read(./storage/app/private/**)",
            "Read(./storage/logs/**)",
            "Read(./**/*.pfx)",
            "Read(./**/*.p12)",
            "Read(./**/*.key)",
            "Read(./**/*.pem)",
            "Read(./**/*.ppk)",
            "Read(./**/id_rsa*)",
            "Read(./**/id_ed25519*)",
            "Edit(./.env)",
            "Edit(./storage/app/private/**)"
        ],
        "ask": [
            "Edit(./.opencode/plugin/**)",
            "Write(./.opencode/plugin/**)",
            "Edit(./opencode.json)",
            "Write(./opencode.json)",
            "Edit(./.claude/settings*.json)",
            "Write(./.claude/settings*.json)",
            "Edit(./.claude/hooks/**)",
            "Write(./.claude/hooks/**)",
            "Edit(./.github/workflows/**)",
            "Write(./.github/workflows/**)",
            "Edit(./.githooks/**)",
            "Write(./.githooks/**)"
        ],
        "allow": [
            "Edit(./**)",
            "Write(./**)",
            "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/tarefa.ps1:*)",
            "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/gate.ps1:*)",
            "Bash(docker exec walle-app php artisan:*)",
            "Bash(docker exec walle-app ./vendor/bin/pest:*)",
            "Bash(docker exec walle-app ./vendor/bin/pint:*)",
            "Bash(docker exec walle-app ./vendor/bin/phpstan:*)",
            "Bash(docker exec -e DB_DATABASE=walle_testes walle-app ./vendor/bin/pest:*)",
            "Bash(docker run --rm -v C:/docker/walle:/app -w /app node:24-alpine npm:*)",
            "Bash(git status:*)",
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "mcp__laravel-boost__search-docs",
            "mcp__laravel-boost__database-schema",
            "mcp__laravel-boost__database-query",
            "mcp__laravel-boost__application-info",
            "mcp__laravel-boost__browser-logs",
            "mcp__laravel-boost__get-absolute-url"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash|PowerShell",
                "hooks": [
                    {
                        "type": "command",
                        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/proteger-comandos.ps1\""
                    }
                ]
            },
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/politica-global.ps1\" -Event PreToolUse",
                        "timeout": 60
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Write|Edit|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/politica-global.ps1\" -Event PostToolUse",
                        "timeout": 60
                    }
                ]
            }
        ],
        "SubagentStop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "powershell.exe",
                        "timeout": 15,
                        "async": true,
                        "args": [
                            "-NoProfile",
                            "-ExecutionPolicy",
                            "Bypass",
                            "-File",
                            "${CLAUDE_PROJECT_DIR}/.claude/hooks/rag.ps1",
                            "-Mode",
                            "capture"
                        ]
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "powershell.exe",
                        "timeout": 15,
                        "async": true,
                        "args": [
                            "-NoProfile",
                            "-ExecutionPolicy",
                            "Bypass",
                            "-File",
                            "${CLAUDE_PROJECT_DIR}/.claude/hooks/rag.ps1",
                            "-Mode",
                            "capture"
                        ]
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "powershell.exe",
                        "timeout": 15,
                        "args": [
                            "-NoProfile",
                            "-ExecutionPolicy",
                            "Bypass",
                            "-File",
                            "${CLAUDE_PROJECT_DIR}/.claude/hooks/rag.ps1",
                            "-Mode",
                            "search"
                        ]
                    }
                ]
            }
        ]
    }
}
