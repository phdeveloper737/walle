{
    "permissions": {
        "deny": [
            "Read(./.env)",
            "Read(./.env.backup)",
            "Read(./.env.production)",
            "Read(./.env.local)",
            "Read(./.env.*.local)",
            "Read(./**/.env)",
            "Read(./auth.json)",
            "Read(./storage/*.key)",
            "Read(./storage/app/private/**)",
            "Read(./storage/logs/**)",
            "Read(./**/*.pfx)",
            "Read(./**/*.p12)",
            "Read(./**/*.key)",
            "Read(./**/*.pem)",
            "Read(./**/*.ppk)",
            "Read(./**/id_rsa*)",
            "Read(./**/id_ed25519*)",
            "Edit(./.env)",
            "Edit(./storage/app/private/**)"
        ],
        "ask": [
            "Edit(./.opencode/plugin/**)",
            "Write(./.opencode/plugin/**)",
            "Edit(./opencode.json)",
            "Write(./opencode.json)"
        ],
        "allow": [
            "Bash(gh pr merge:*)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash|PowerShell",
                "hooks": [
                    {
                        "type": "command",
                        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/proteger-comandos.ps1\""
                    }
                ]
            },
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/politica-global.ps1\" -Event PreToolUse",
                        "timeout": 60
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Write|Edit|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/politica-global.ps1\" -Event PostToolUse",
                        "timeout": 60
                    }
                ]
            }
        ],
        "SubagentStop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "powershell.exe",
                        "timeout": 15,
                        "async": true,
                        "args": [
                            "-NoProfile",
                            "-ExecutionPolicy",
                            "Bypass",
                            "-File",
                            "${CLAUDE_PROJECT_DIR}/.claude/hooks/rag.ps1",
                            "-Mode",
                            "capture"
                        ]
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "powershell.exe",
                        "timeout": 15,
                        "async": true,
                        "args": [
                            "-NoProfile",
                            "-ExecutionPolicy",
                            "Bypass",
                            "-File",
                            "${CLAUDE_PROJECT_DIR}/.claude/hooks/rag.ps1",
                            "-Mode",
                            "capture"
                        ]
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "powershell.exe",
                        "timeout": 15,
                        "args": [
                            "-NoProfile",
                            "-ExecutionPolicy",
                            "Bypass",
                            "-File",
                            "${CLAUDE_PROJECT_DIR}/.claude/hooks/rag.ps1",
                            "-Mode",
                            "search"
                        ]
                    }
                ]
            }
        ]
    }
}
